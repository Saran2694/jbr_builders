# ========================================================
# JBR Builders — Environment Variables Configuration
# ========================================================

# 1. Email Service (Resend)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=JBR Builders <contact@datamintaarvix.com>
RECIPIENT_EMAIL=jbrbuilders15@gmail.com

# 2. Firebase Configuration (Client & Admin Auth/Firestore)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# 3. Cloudinary Configuration (Server-Side Image Storage & Delivery)
# Secret is kept strictly on server and NEVER exposed to frontend code
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
